generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Patient conversation thread — one per unique phone number
model Conversation {
  id                String    @id @default(cuid())
  patientName       String    @map("patient_name")
  phoneNumber       String    @unique @map("phone_number")
  conversationType  String    @default("existing_patient") @map("conversation_type") // "new_lead" | "existing_patient"
  assignedUserId    String?   @map("assigned_user_id")
  lastMessage       String?   @map("last_message")
  lastMessageSender String?   @map("last_message_sender") // "patient" | "agent"
  lastMessageTime   DateTime? @map("last_message_time")
  unreadCount       Int       @default(0) @map("unread_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  messages     Message[]
  assignedUser User?    @relation(fields: [assignedUserId], references: [id])

  @@map("inbox_conversations")
}

/// Individual message within a conversation
model Message {
  id               String   @id @default(cuid())
  conversationId   String   @map("conversation_id")
  gupshupMessageId String?  @map("gupshup_message_id")
  senderType       String   @map("sender_type")
  message          String
  messageType      String   @default("text") @map("message_type")
  status           String   @default("sent")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("inbox_messages")
}

/// Staff user account for inbox access
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("agent")
  createdAt DateTime @default(now()) @map("created_at")

  assignedConversations Conversation[]

  @@map("inbox_users")
}

/// Custom message templates defined by clinic staff
model Template {
  id        String   @id @default(cuid())
  title     String
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inbox_templates")
}

/// Marketing Broadcast Campaigns
model BroadcastCampaign {
  id           String         @id @default(cuid())
  templateId   String         @map("template_id")
  templateName String?        @map("template_name")
  totalCount   Int            @default(0) @map("total_count")
  successCount Int            @default(0) @map("success_count")
  failedCount  Int            @default(0) @map("failed_count")
  createdAt    DateTime       @default(now()) @map("created_at")

  logs         BroadcastLog[]

  @@map("inbox_broadcast_campaigns")
}

/// Per-recipient delivery log for broadcast messages
model BroadcastLog {
  id           String             @id @default(cuid())
  campaignId   String?            @map("campaign_id")
  name         String
  phone        String
  status       String             // "submitted" | "failed"
  messageId    String?            @map("gupshup_message_id")
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at")

  campaign     BroadcastCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("inbox_broadcast_logs")
}
